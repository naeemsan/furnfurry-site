{
  "name": "furnfurry-site",
  "main": "worker.js",
  "compatibility_date": "2026-04-24",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}